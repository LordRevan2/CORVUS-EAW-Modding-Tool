{
  "name": "corvus-eaw-modding-tool",
  "private": true,
  "version": "2.0.10",
  "type": "module",
  "main": "main.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/LordRevan2/corvus-eaw-modding-tool.git"
  },
  "build": {
    "appId": "com.eaw.corvus",
    "productName": "CORVUS // EAW Modding Tool",
    "publish": [
      {
        "provider": "github",
        "owner": "LordRevan2",
        "repo": "corvus-eaw-modding-tool"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CORVUS",
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "installerSidebar": "build/installerSidebar.png",
      "installerHeader": "build/installerHeader.png",
      "uninstallerSidebar": "build/installerSidebar.png",
      "uninstallDisplayName": "CORVUS // EAW Modding Tool",
      "allowElevation": true
    },
    "mac": {
      "icon": "public/icon.png"
    },
    "files": [
      "dist/**/*",
      "main.cjs"
    ]
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "electron:start": "electron .",
    "electron:build": "node generate_icon.js && npm run build && electron-builder --win",
    "electron:publish": "node generate_icon.js && npm run build && electron-builder --win -p always"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/prismjs": "^1.26.6",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "electron-updater": "^6.8.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "prismjs": "^1.30.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-simple-code-editor": "^0.14.1",
    "tga-js": "^1.1.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.25.0",
    "jimp": "^1.6.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
