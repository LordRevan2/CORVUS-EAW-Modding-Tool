{
  "name": "corvus-eaw-modding-tool",
  "private": true,
  "version": "3.1.1",
  "type": "module",
  "main": "main.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/LordRevan2/corvus-eaw-modding-tool.git"
  },
  "build": {
    "appId": "com.eaw.corvus",
    "productName": "CORVUS // EAW Modding Tool",
    "publish": [
      {
        "provider": "github",
        "owner": "LordRevan2",
        "repo": "corvus-eaw-modding-tool"
      }
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CORVUS - EAW Modding Tool",
      "menuCategory": "CORVUS Modding",
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico",
      "installerHeaderIcon": "public/icon.ico",
      "installerHeader": "public/installerHeader.bmp",
      "installerSidebar": "public/installerSidebar.bmp",
      "uninstallerSidebar": "public/installerSidebar.bmp",
      "include": "build/installer.nsh",
      "license": "build/LICENSE.txt",
      "language": "1034",
      "runAfterFinish": true,
      "uninstallDisplayName": "CORVUS // EAW Modding Tool",
      "artifactName": "CORVUS-EAW-Modding-Tool-Setup-${version}.${ext}",
      "allowElevation": true
    },
    "mac": {
      "icon": "public/icon.png"
    },
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "main.cjs"
    ]
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "generate:assets": "node generate_icon.js",
    "electron:start": "electron .",
    "electron:preview": "npm run generate:assets && npm run build && electron .",
    "electron:build:win": "npm run generate:assets && npm run build && electron-builder --win",
    "electron:build:mac": "npm run generate:assets && npm run build && electron-builder --mac",
    "electron:build:linux": "npm run generate:assets && npm run build && electron-builder --linux",
    "electron:build:all": "npm run generate:assets && npm run build && electron-builder --win --mac --linux",
    "electron:publish": "npm run generate:assets && npm run build && electron-builder --win --publish always"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/prismjs": "^1.26.6",
    "@vitejs/plugin-react": "^5.0.4",
    "7zip-bin": "^5.2.0",
    "dotenv": "^17.2.3",
    "electron-updater": "^6.8.3",
    "express": "^4.21.2",
    "lua-fmt": "^2.6.0",
    "luaparse": "^0.3.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "node-7z": "^3.0.0",
    "node-unrar-js": "^2.0.2",
    "prismjs": "^1.30.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-simple-code-editor": "^0.14.1",
    "tga-js": "^1.1.1",
    "unrar-js": "^0.2.3",
    "xml-formatter": "^3.7.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "electron": "^42.3.3",
    "electron-builder": "^26.8.1",
    "electron-is-dev": "^3.0.1",
    "esbuild": "^0.25.0",
    "jimp": "^1.6.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
